Options -MultiViews
DirectoryIndex index.html
ErrorDocument 404 /404.html

# Redirect legacy routes before serving the prerendered static pages
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteRule ^index\.html$ / [R=301,L,NC]
  RewriteRule ^work/(.+)$ /projects/$1 [R=301,L,NC]
  RewriteRule ^work/?$ /projects [R=301,L,NC]
  RewriteRule ^design/?$ /ui-ux [R=301,L,NC]
</IfModule>
